{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self'; frame-src 'self' https://maintenance.aoadispatch.com; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ground-attendance/checkin/:sessionId",
      "destination": "/ground-attendance-checkin.html"
    },
    {
      "source": "/ground-attendance/daily/:templateId",
      "destination": "/ground-attendance-checkin.html"
    }
  ]
}
